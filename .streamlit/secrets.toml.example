# Copy this file to  .streamlit/secrets.toml  and put your real key in it. secrets.toml is already in .gitignore: never commit it.
# On Streamlit Community Cloud paste the same line into  App settings -> Secrets  instead.
GEMINI_API_KEY = "paste-your-key-here"
# Optional: models to try, in order (default: gemini-3.5-flash, gemini-2.5-flash). Can also be set as an environment variable.
# GEMINI_MODEL = "gemini-2.5-flash"
